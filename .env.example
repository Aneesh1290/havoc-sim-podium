# =============================================
# HAVOC SIM PODIUM — Environment Variables
# =============================================
# 1. Copy this file and rename it to ".env"
# 2. Fill in your actual Cashfree credentials
# 3. NEVER commit .env to git — keep it private
# =============================================

# Cashfree Credentials (get from Cashfree Merchant Dashboard)
CASHFREE_APP_ID=YOUR_CASHFREE_APP_ID
CASHFREE_SECRET_KEY=YOUR_CASHFREE_SECRET_KEY
CASHFREE_ENV=sandbox

# Server port (default: 3000)
PORT=3000

# =============================================
# ICICI UPI SDK Credentials
# =============================================
ICICI_MERCHANT_ID=YOUR_MERCHANT_ID
ICICI_TERMINAL_ID=YOUR_TERMINAL_ID

EAZYPAY_KEYSTORE_PATH=./keys/keystore.p12
EAZYPAY_KEYSTORE_PASSWORD=YOUR_KEYSTORE_PASSWORD
EAZYPAY_KEYSTORE_ALIAS=YOUR_ALIAS
EAZYPAY_API_KEY=YOUR_API_KEY
ENV_TYPE=UAT
EAZYPAY_PRIVATE_PEM_PATH=./keys/private-key.pem
